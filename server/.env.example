# 复制本文件为 .env 后按需修改；未设置的项使用代码中的默认值。
# 相对路径均以 server 目录为基准。

# 运行环境：development / production
NODE_ENV=development

# API监听本机，由HTTPS反向代理对外提供访问；不要自动信任X-Forwarded-For
API_HOST=127.0.0.1
API_PORT=3001

# SQLite 数据库文件路径
DATABASE_FILE_PATH=data/ssq.db

# 官方接口原始响应存档目录（字段变更时可回放解析）
RAW_RESPONSE_ARCHIVE_DIR=data/raw_responses

# 停售期配置文件（春节休市等），修改后无需重启
SALES_SUSPENSION_CONFIG_PATH=config/sales-suspension-periods.json

# 中国福彩网开奖查询接口地址
CWL_DRAW_NOTICE_API_URL=https://www.cwl.gov.cn/cwl_admin/front/cwlkj/search/kjxx/findDrawNotice

# 两次请求官方接口之间的最小间隔（毫秒），不低于 1000
CWL_REQUEST_INTERVAL_MS=1500

# 单次请求超时时间（毫秒）
CWL_REQUEST_TIMEOUT_MS=15000

# 管理接口密钥：Authorization: Bearer <密钥>，不允许放入小程序或浏览器代码
# 未设置则全部管理接口禁用；生产设置时至少32个字符，应使用高熵随机字符串
ADMIN_API_KEY=
